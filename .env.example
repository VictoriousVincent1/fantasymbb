# Copy to ~/.config/fantasy-trade-coach/.env (recommended, stays out of iCloud)
# or to .env in this folder. Never commit or share it: these cookies give access
# to your ESPN account.
ESPN_LEAGUE_ID=
# ESPN labels a season by the year it ends, so 2026-27 is 2027.
ESPN_YEAR=2027
# Private leagues only. In a browser signed in to ESPN: DevTools > Application > Cookies.
ESPN_S2=
ESPN_SWID=
# Optional: the team selected when the app opens.
ESPN_TEAM_ID=
